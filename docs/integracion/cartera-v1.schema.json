{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:databridge:contratos:cartera:1.0",
  "title": "Cartera v1",
  "description": "Cartera morosa. Es el mismo formato en toda la cadena: acreedor → agencia (Patrimonio → APOFYX) y agencia → plataforma (APOFYX → DataBridge). Ver docs/integracion/README.md §6. Hay reglas que JSON Schema no puede expresar (dígito verificador del RUT, cargos vencidos, ids únicos dentro del lote); esas las valida cada receptor al recibir (§6.4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "lote", "deudas"],
  "properties": {
    "version": { "const": "1.0" },
    "lote": { "$ref": "#/definitions/lote" },
    "deudas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": { "$ref": "#/definitions/deuda" }
    }
  },
  "definitions": {
    "rut": {
      "description": "RUT sin puntos, con guion y K mayúscula. El dígito verificador (módulo 11) lo valida DataBridge.",
      "type": "string",
      "pattern": "^[1-9][0-9]{5,7}-[0-9K]$"
    },
    "idExterno": {
      "description": "Id en el sistema de quien lo emite.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "fecha": { "type": "string", "format": "date" },
    "lote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id_externo", "fecha_corte", "acreedor"],
      "properties": {
        "id_externo": {
          "$ref": "#/definitions/idExterno",
          "description": "Único por emisor. Es la clave de idempotencia del envío."
        },
        "fecha_corte": {
          "$ref": "#/definitions/fecha",
          "description": "Fecha a la que están calculados los montos. La mora se mide contra ella."
        },
        "emitido_en": { "type": "string", "format": "date-time" },
        "acreedor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rut"],
          "properties": {
            "rut": { "$ref": "#/definitions/rut" },
            "razon_social": { "type": "string", "maxLength": 160 },
            "nombre_fantasia": { "type": "string", "maxLength": 120 }
          }
        },
        "mandato": {
          "description": "Lo agrega la agencia al reenviar la cartera a la plataforma: su RUT y la campaña a la que la asignó. El acreedor no lo manda. Sin mandato, es gestión directa del acreedor.",
          "type": "object",
          "additionalProperties": false,
          "required": ["agencia_rut", "campana_id_externo"],
          "properties": {
            "agencia_rut": { "$ref": "#/definitions/rut" },
            "campana_id_externo": { "$ref": "#/definitions/idExterno" }
          }
        }
      }
    },
    "deudor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rut", "tipo", "nombre"],
      "anyOf": [{ "required": ["correo"] }, { "required": ["telefono"] }],
      "properties": {
        "rut": { "$ref": "#/definitions/rut" },
        "tipo": { "enum": ["persona", "empresa"] },
        "nombre": { "type": "string", "minLength": 2, "maxLength": 160 },
        "correo": { "type": "string", "format": "email", "maxLength": 254 },
        "telefono": {
          "description": "E.164, sin espacios: +56987654321",
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{7,14}$"
        }
      }
    },
    "cargo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concepto", "monto", "fecha_vencimiento"],
      "properties": {
        "concepto": { "type": "string", "minLength": 1, "maxLength": 120 },
        "periodo": {
          "description": "Mes al que corresponde el cargo, si aplica.",
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "monto": {
          "description": "Lo que se debe hoy de este cargo, en la moneda de la deuda. En CLP es entero; en UF, hasta 2 decimales.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fecha_vencimiento": { "$ref": "#/definitions/fecha" }
      }
    },
    "deuda": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id_externo"],
      "properties": {
        "id_externo": {
          "$ref": "#/definitions/idExterno",
          "description": "Id de la obligación en el sistema del acreedor. Único por acreedor. Viaja intacto por toda la cadena: es lo que permite que un pago vuelva al contrato correcto."
        },
        "accion": { "enum": ["registrar", "retirar"], "default": "registrar" },
        "motivo_retiro": {
          "enum": ["pago_directo", "acuerdo_directo", "error", "disputa_resuelta", "fuera_de_mandato", "otro"]
        },
        "deudor": { "$ref": "#/definitions/deudor" },
        "moneda": { "enum": ["CLP", "UF"] },
        "concepto": { "type": "string", "minLength": 1, "maxLength": 200 },
        "referencias": {
          "description": "Pares clave-valor que se le muestran al deudor para que reconozca la deuda.",
          "type": "object",
          "maxProperties": 10,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,31}$" },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "cargos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 120,
          "items": { "$ref": "#/definitions/cargo" }
        }
      },
      "if": {
        "required": ["accion"],
        "properties": { "accion": { "const": "retirar" } }
      },
      "then": {
        "required": ["motivo_retiro"]
      },
      "else": {
        "required": ["deudor", "moneda", "concepto", "cargos"],
        "not": { "required": ["motivo_retiro"] },
        "allOf": [
          {
            "if": {
              "required": ["moneda"],
              "properties": { "moneda": { "const": "CLP" } }
            },
            "then": {
              "properties": {
                "cargos": { "items": { "properties": { "monto": { "type": "integer" } } } }
              }
            }
          }
        ]
      }
    }
  }
}
