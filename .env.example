# =============================================================================
#  Variables de entorno de TB_web
# =============================================================================
#  Copia este archivo como .env (en esta carpeta) y cambia lo que necesites.
#  Todas tienen un valor por omision de desarrollo: sin .env el sistema
#  arranca igual en un equipo nuevo. Fuera de desarrollo, cambia al menos los
#  SECRETOS COMPARTIDOS.
#
#  Lo leen dos cosas:
#    - docker compose, que las pasa a los contenedores.
#    - cada servicio de Spring al correr con Maven (spring.config.import).
#  Una variable de entorno de verdad (la terminal, Docker) manda sobre el .env.
# =============================================================================

# ---- Secretos compartidos ------------------------------------------------------
#  El JWT lo firma ms-auth y lo verifican ms-debt y ms-payments: tiene que ser
#  el mismo en los tres. Al menos 32 caracteres, o los servicios no arrancan.
JWT_SECRET=tbridge-dev-secret-change-me-32chars
#  La clave con que los servicios se hablan entre ellos por /internal.
INTERNAL_KEY=tbridge-internal-dev
#  La firma de los enlaces de pago y de los avisos de las pasarelas.
WEBHOOK_SECRET=tbridge-webhook-dev

# ---- Puertos y direcciones -----------------------------------------------------
#  Donde queda el portal en Docker (nginx).
PORTAL_PORT=8080
#  La direccion del portal que va en los correos y en los enlaces de pago.
#  En Docker, http://localhost:8080; con Vite, http://localhost:5173.
PUBLIC_URL=http://localhost:8080
MYSQL_PORT=3308

# ---- MySQL -----------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_USER=tbridge
MYSQL_PASSWORD=tbridge_pass

# ---- ms-auth: la sesion ----------------------------------------------------------
#  El JWT dura poco a proposito: no se puede revocar. Lo que dura es la llave
#  de renovacion, que si.
JWT_TTL_MINUTES=15
#  Cuanto dura una sesion desde que se entra. Renovar no la alarga.
REFRESH_TTL_HOURS=168
#  true con HTTPS. Con HTTP el navegador descarta una cookie Secure en silencio.
COOKIE_SECURE=false
CODE_TTL_HOURS=24
MAGIC_TTL_MINUTES=15

# ---- ms-auth: correo ---------------------------------------------------------------
#  En Docker los correos van al buzon de prueba (http://localhost:8025) y
#  estas no se usan. Con Maven, sin SMTP_HOST el codigo queda en el log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=noreply@technicalbridge.local

# ---- ms-debt: el alcance ---------------------------------------------------------
#  DataBridge cobra a deudores morosos: una deuda entra con al menos estos meses
#  impagos. Con menos, se rechaza al recibir la cartera (bajo_umbral_mora).
MIN_MESES_IMPAGOS=2

#  Cuantos dias antes de que venza una cuota le llega al deudor el recordatorio.
RECORDATORIO_DIAS_ANTES=3
#  Los deudores de ejemplo de la demo. Fuera de una demo: false (Patrimonio y
#  APOFYX quedan registradas igual: son la cadena, no la demo).
DEMO_DATOS=true

# ---- ms-debt y ms-payments: RabbitMQ (opcional) --------------------------------
#  Sin RabbitMQ, ms-payments le avisa los pagos a ms-debt por HTTP. En Docker
#  se usa RabbitMQ.
EVENTS_RABBIT=false
RABBIT_USER=guest
RABBIT_PASSWORD=guest

# ---- ms-payments: la UF --------------------------------------------------------
#  Del Banco Central (registro en si3.bcentral.cl). Sin esto, la UF se carga a
#  mano: POST /internal/uf en ms-payments.
BCENTRAL_USER=
BCENTRAL_PASS=

# ---- gateway ----------------------------------------------------------------------
#  Peticiones por minuto y por cliente: el estrecho para el codigo de acceso,
#  el general para todo lo demas.
RATE_AUTH_CAPACITY=10
RATE_GLOBAL_CAPACITY=120
#  Quien puede llamar al gateway con credenciales desde otro origen. El portal
#  no lo necesita: nginx y Vite lo sirven desde el mismo.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Swagger ------------------------------------------------------------------------
#  false para apagar la documentacion (por ejemplo, en produccion).
SWAGGER_ENABLED=true

# ---- ms-ai: el asistente (opcional) --------------------------------------------
#  Sin llave responde con reglas locales, que es el camino por omision.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
